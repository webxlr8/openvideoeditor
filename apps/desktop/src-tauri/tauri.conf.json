{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenVideoEditor",
  "version": "0.1.0",
  "identifier": "dev.openvideoeditor.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenVideoEditor",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#121212",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ove-frame: http://ove-frame.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "m4v",
          "mov",
          "mxf",
          "mkv",
          "webm"
        ],
        "name": "Video",
        "description": "Video file",
        "role": "Viewer"
      },
      {
        "ext": [
          "m4a",
          "wav",
          "caf",
          "opus",
          "ogg",
          "aac"
        ],
        "name": "Audio",
        "description": "Audio file",
        "role": "Viewer"
      }
    ]
  }
}
